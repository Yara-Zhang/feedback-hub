# 部署配置模板：复制为 scripts/.deploy.env 并填入真实值（该文件不入库）
# Supabase Management API
SUPA_ACCESS_TOKEN=你的Access Token（Account Settings → Access Tokens）
SUPA_PROJECT_REF=项目 ref（Project URL 中 https://<ref>.supabase.co）

# 函数 Secrets（部署时写入）
JWT_SECRET=随机64位hex（openssl rand -hex 32）
CRON_SECRET=随机32位hex（openssl rand -hex 16）
TIKHUB_API_KEY=
DEEPSEEK_API_KEY=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=
FRONTEND_URL=https://<github用户名>.github.io/feedback-hub/
